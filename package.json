{
  "name": "university-portal",
  "version": "1.0.0",
  "private": true,
  "description": "University management system API",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "format": "prettier --write \"**/*.ts\" \"*.json\" \"README.md\"",
    "format:check": "prettier --check \"**/*.ts\" \"*.json\" \"README.md\"",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "seed:test-users": "tsx scripts/create_user.ts",
    "migrate:users-email": "tsx scripts/migrate_user_email.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "joi": "^18.3.1",
    "mongoose": "^8.9.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.5",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
